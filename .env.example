# Vorlage fuer lokale Umgebungsvariablen.
# Kopieren nach .env.local — die echte Datei bleibt durch .gitignore aussen vor.
#
# Ohne diese Werte laeuft die App vollstaendig: die ersten Tage sind lesbar,
# der Kaufknopf zeigt statt der Kasse einen Hinweis. Erst beide Werte
# zusammen schalten den Verkauf scharf.

# Stripe, geheimer Schluessel. Zum Testen der mit sk_test_ beginnt.
STRIPE_SECRET_KEY=

# Unterschluessel fuer den Zugangs-Cookie. Mindestens 32 Zeichen.
# Erzeugen mit:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Wird dieser Wert spaeter geaendert, verlieren alle Kaeuferinnen und Kaeufer ihren Zugang.
ZUGANG_GEHEIMNIS=

# Oeffentliche Adresse der App, ohne Schraegstrich am Ende.
# Auf Vercel nicht noetig — die Adresse wird dort automatisch erkannt.
APP_URL=

# Adresse, an die Anmeldungen als JSON geschickt werden (MailerLite, Buttondown,
# Brevo, eigener Endpunkt). Ohne diesen Wert werden Anmeldungen im Produktiv-
# betrieb abgelehnt, statt sie stillschweigend zu verlieren.
ANMELDUNG_WEBHOOK=

# Zusaetzliche AGB-Zustimmung durch Stripe einschalten (1 = an).
# Erst einschalten, wenn im Stripe-Konto unter Checkout-Einstellungen eine
# AGB-Adresse hinterlegt ist, sonst weist Stripe die Kassensitzung ab.
STRIPE_AGB_ZUSTIMMUNG=
